{
  "name": "ahorro-u",
  "private": true,
  "version": "1.0.0",
  "description": "Aplicación local para planear y registrar ahorro universitario compartido mediante SQLite.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k --names server,web \"npm run dev:server\" \"npm run dev:web\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build && npm run build:server",
    "build:server": "tsc -p server/tsconfig.json && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=server-dist/index.js",
    "start": "node server-dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.1",
    "decimal.js": "^10.5.0",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.4",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.2.7"
  }
}
